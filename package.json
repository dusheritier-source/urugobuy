{
  "name": "urugo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:launch": "node scripts/check-launch.mjs",
    "admin:set-role": "node --env-file=.env.local scripts/set-admin-role.mjs",
    "index:visual-search": "node scripts/index-visual-search.mjs",
    "test:visual-search": "node --test tests/visual-search.test.mjs",
    "test:visual-search:browser": "playwright test",
    "test:assistant": "node --test tests/assistant.test.mjs tests/gemini.test.mjs",
    "test:assistant:browser": "playwright test assistant.spec.ts",
    "check:assistant": "node scripts/check-assistant.mjs",
    "test:recommendations": "node --test tests/recommendations.test.mjs",
    "test:recommendations:browser": "playwright test recommendations.spec.ts",
    "test:price-alerts": "node --test tests/price-alerts.test.mjs tests/price-alert-workflow.test.mjs",
    "test:price-alerts:browser": "playwright test price-alerts.spec.ts",
    "jobs:price-alerts": "node --env-file=.env.local scripts/process-price-alerts.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@huggingface/transformers": "^3.8.1",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "firebase-admin": "13.10.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-hot-toast": "^2.6.0",
    "sharp": "^0.34.5",
    "svix": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
